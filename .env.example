OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
SCHOLARMEND_S2_KEY=
# an e-mail address for Crossref's polite pool (op ingest crossref). Optional: unset or blank, Crossref is queried
# through the public pool; a malformed value stops the crawl (bad_contact). Never committed, logged or put in a URL.
CROSSREF_MAILTO=
# an optional OpenAlex API key (op ingest openalex, op eval openalex): raises the daily budget; never committed
# (sent as a request header only, never in a URL, a cache entry or a log line)
OPENALEX_API_KEY=
