ath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js\"\n        integrity=\"sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy\"\n        crossorigin=\"anonymous\"></script>\n<script>\n    $('.dropdown-menu a.dropdown-toggle').on('click', function (e) {\n        if (!$(this).next().hasClass('show')) {\n            $(this).parents('.dropdown-menu').first().find('.show').removeClass(\"show\");\n        }\n        var $subMenu = $(this).next(\".dropdown-menu\");\n        $subMenu.toggleClass('show');\n\n\n        $(this).parents('li.nav-item.dropdown.show').on('hidden.bs.dropdown', function (e) {\n            $('.dropdown-submenu .show').removeClass(\"show\");\n        });\n\n\n        return false;\n    });\n</script>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const filters = document.querySelectorAll('.track-filter');\n    const papers = document.querySelectorAll('.paper-list li');\n    const countEl = document.querySelector('.paper-count');\n    const totalCount = papers.length;\n\n    // Build mapping of track slug -> track-N class from filter buttons\n    const trackClassMap = {};\n    filters.forEach(filter => {\n        const track = filter.dataset.track;\n        const trackClass = filter.dataset.trackClass;\n        if (track && trackClass) {\n            trackClassMap[track] = trackClass;\n        }\n    });\n\n    // Apply track classes to paper items\n    papers.forEach(paper => {\n        const track = paper.dataset.track;\n        if (track && trackClassMap[track]) {\n            paper.classList.add(trackClassMap[track]);\n        }\n    });\n\n    // Filter click handlers\n    filters.forEach(filter => {\n        filter.addEventListener('click', function() {\n            const track = this.dataset.track;\n\n            // Update active state\n            filters.forEach(f => f.classList.remove('active'));\n            this.classList.add('active');\n\n            // Filter papers\n            let visibleCount = 0;\n            papers.forEach(paper => {\n                if (track === 'all' || paper.dataset.track === track) {\n                    paper.style.display = '';\n                    visibleCount++;\n                } else {\n                    paper.style.display = 'none';\n                }\n            });\n\n            // Update count\n            if (track === 'all') {\n                countEl.textContent = totalCount + ' papers';\n            } else {\n                countEl.textContent = visibleCount + ' of ' + totalCount + ' papers';\n            }\n        });\n    });\n});\n</script>\n\n\n<br> \n        <div class=\"modal fade\" id=\"myModal\">\n          <div class=\"modal-dialog\">\n            <div class=\"modal-content\">\n              <div class=\"modal-header\">\n                <h4 class=\"modal-title\">Name Change Policy</h4>\n                <button type=\"button pull-right\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n              </div>\n              <div class=\"modal-body\">\n                <p>Requests for name changes in the electronic proceedings will be accepted with no questions asked.  However name changes may cause bibliographic tracking issues.  Authors are asked to consider this carefully and discuss it with their co-authors prior to requesting a name change in the electronic proceedings.</p>\n\n<p>Use the \"Report an Issue\" link to request a name change.</p>\n\n              </div> \n              <div class=\"modal-footer\">\n\n\n              </div>\n            </div><!-- /.modal-content -->\n          </div><!-- /.modal-dialog -->\n        </div><!-- /.modal -->\n\n\n\n<footer class=\"footer\">\n    <div class=\"btn-spacer\">\n        <a href=\"https://neurips.cc/Help/Contact?select=Conference\">Report an Issue</a> &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;        <a href=\"#\" class=\"modal-link\" data-toggle=\"modal\" data-target=\"#myModal\">Name Change Policy</a>\n    </div