  "text": "\n\n\n\n<!doctype html>\n<html lang=\"en\">\n<head>\n\n    <!-- Required meta tags -->\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <title>Book</title>\n    <!-- Bootstrap CSS -->\n    <!-- https://codepen.io/surjithctly/pen/PJqKzQ -->\n    <link href=\"https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css\" rel=\"stylesheet\" integrity=\"sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH\" crossorigin=\"anonymous\">\n    <link rel=\"stylesheet\" href=\"https://use.fontawesome.com/releases/v5.8.1/css/all.css\"\n          integrity=\"sha384-50oBUHEmvpQ+1lW4y57PTFmhCaXp0ML5d60M1M7uH2+nqUivzIebhndOJK28anvf\" crossorigin=\"anonymous\">\n\n    <!-- Custom CSS (after Bootstrap so it can override) -->\n    <link rel=\"stylesheet\" href=\"/static/papers/css/papers.css\">\n    <link rel=\"stylesheet\" href=\"/static/papers/css/modern-theme.css?v=12\">\n\n    \n    \n\n\n    <script type=\"text/javascript\" async\n            src=\"https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.7/latest.js?config=TeX-MML-AM_CHTML\">\n    </script>\n    <script type=\"text/x-mathjax-config\">\n        MathJax.Hub.Config({\n      \"tex2jax\": {\n        \"inlineMath\": [[\"$\",\"$\"], [\"\\\\(\",\"\\\\)\"]],\n        \"displayMath\": [[\"\\\\[\",\"\\\\]\"]],\n        \"processEscapes\": true\n      }\n    }\n    );\n\n    </script>\n\n    <style>\n        @media (prefers-color-scheme: dark) {\n            body {\n                background-color: #333;\n                color: #eee;\n            }\n        }\n\n        .btn-spacer {\n            margin: 2px;\n        }\n\n        .footer {\n            position: fixed;\n            left: 0;\n            bottom: 0;\n            width: 100%;\n            background-color: #eee;\n            color: black;\n        }\n\n\n    </style>\n\n</head>\n\n\n<body class=\"modern-theme\">\n\n\n<nav class=\"navbar navbar-expand-md bg-body-tertiary\">\n    <div class=\"container-fluid\">\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <a class=\"navbar-brand\" href=\"/\">NeurIPS Proceedings</a>\n        <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarSupportedContent\" aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n            <span class=\"navbar-toggler-icon\"></span>\n        </button>\n        <div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\">\n            <ul class=\"navbar-nav me-auto mb-2 mb-lg-0\">\n                            <li class=\"nav-item\">\n                <a class=\"nav-link\" href=\"/admin/login/?next=/admin/\"><i class=\"fas fa-sign-in-alt\" title=\"Login\"></i></a>\n            </li>\n            <li class=\"nav-item\">\n                <a class=\"nav-link\" href=\"/admin/logout/?nextp=/admin\"><i class=\"fas fa-sign-out-alt\" title=\"Logout\"></i></a>\n            </li>\n\n            </ul>\n            <form class=\"d-flex\" role=\"search\" method=\"get\" role=\"search\" action=\"/papers/search\">\n                <input class=\"form-control me-2\" type=\"search\" placeholder=\"Search\" aria-label=\"Search\" name=\"q\">\n                <button class=\"btn btn-outline-success\" type=\"submit\">Search</button>\n            </form>\n        </div>\n    </div>\n</nav>\n\n\n\n\n    <div class=\"container-fluid\">\n        <div class=\"col book-page\">\n            <header class=\"book-header\">\n                <h1 class=\"book-title\">Advances in Neural Information Processing Systems 38 Creative AI </h1>\n                <p class=\"book-meta\">NeurIPS 2025</p>\n                \n                    <p class=\"book-editors\">Edited by D. Belgrave and C. Zhang and M. Coelho and L. Elliott and Y. Tian and P. Prakash</p>\n                \n                \n                \n                    <p class=\"book-see-also\">See also: <a href=\"/paper_files/paper/2025/vol38-main-conference\">Advances in Neural Information Processing Systems 38 Main Conference </a></p>\n                \n            </header>\n\n            <div class=\"paper-list-header\">\n                <span class=\"paper-count\">64 papers</span>\n                \n            </div>\n\n            <ul class=\"paper-list\">\n                \n                    <li class=\"creative_ai_track\" data-track=\"creative_ai_track\">\n                        <div class=\"paper-content\">\n                            <a title=\"paper title\" href=\"/paper_files/paper/2025/hash/04440b43c10100305d21cdeb60262e98-Abstract-Creative_AI_Track.html\">Synthetic title 1</a>\n                            <span class=\"paper-authors\">Synthetic authors 3 &amp;quot;alias&amp;quot;</span>\n                        </div>\n                        \n                        <span class=\"paper-track-badge\">Creative AI</span>\n                        \n                    </li>\n<li class=\"creative_ai_track\" data-track=\"creative_ai_track\">\n                        <div class=\"paper-content\">\n                            <a title=\"paper title\" href=\"/paper_files/paper/2025/hash/1350a018b6442df34ef97648647a3e16-Abstract-Creative_AI_Track.html\">Synthetic title 2</a>\n                            <span class=\"paper-authors\">Synthetic authors 4</span>\n                        </div>\n                        \n                        <span class=\"paper-track-badge\">Creative AI</span>\n                        \n                    </li>\n                \n            </ul>\n        </div>\n    </div>\n\n\n<script   src=\"https://code.jquery.com/jquery-3.7.1.min.js\"\n          integrity=\"sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=\"   crossorigin=\"anonymous\"></script>\n<script src=\"https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js\"\n        integrity=\"sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo\"\n        crossorigin=\"anonymous\"></script>\n<script src=\"https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/js/bootstrap.min.js\"\n        integrity=\"sha384-ChfqqxuZUCnJSK3+MXmPNIyE6ZbWh2IMqE241rYiqJxyMiZ6OW/JmZQ5stwEULTy\"\n        crossorigin=\"anonymous\"></script>\n<script>\n    $('.dropdown-menu a.dropdown-toggle').on('click', function (e) {\n        if (!$(this).next().hasClass('show')) {\n            $(this).parents('.dropdown-menu').first().find('.show').removeClass(\"show\");\n        }\n        var $subMenu = $(this).next(\".dropdown-menu\");\n        $subMenu.toggleClass('show');\n\n\n        $(this).parents('li.nav-item.dropdown.show').on('hidden.bs.dropdown', function (e) {\n            $('.dropdown-submenu .show').removeClass(\"show\");\n        });\n\n\n        return false;\n    });\n</script>\n\n\n<script>\ndocument.addEventListener('DOMContentLoaded', function() {\n    const filters = document.querySelectorAll('.track-filter');\n    const papers = document.querySelectorAll('.paper-list li');\n    const countEl = document.querySelector('.paper-count');\n    const totalCount = papers.length;\n\n    // Build mapping of track slug -> track-N class from filter buttons\n    const trackClassMap = {};\n    filters.forEach(filter => {\n        const track = filter.dataset.track;\n        const trackClass = filter.dataset.trackClass;\n        if (track && trackClass) {\n            trackClassMap[track] = trackClass;\n        }\n    });\n\n    // Apply track classes to paper items\n    papers.forEach(paper => {\n        const track = paper.dataset.track;\n        if (track && trackClassMap[track]) {\n            paper.classList.add(trackClassMap[track]);\n        }\n    });\n\n    // Filter click handlers\n    filters.forEach(filter => {\n        filter.addEventListener('click', function() {\n            const track = this.dataset.track;\n\n            // Update active state\n            filters.forEach(f => f.classList.remove('active'));\n            this.classList.add('active');\n\n            // Filter papers\n            let visibleCount = 0;\n            papers.forEach(paper => {\n                if (track === 'all' || paper.dataset.track === track) {\n                    paper.style.display = '';\n                    visibleCount++;\n                } else {\n                    paper.style.display = 'none';\n                }\n            });\n\n            // Update count\n            if (track === 'all') {\n                countEl.textContent = totalCount + ' papers';\n            } else {\n                countEl.textContent = visibleCount + ' of ' + totalCount + ' papers';\n            }\n        });\n    });\n});\n</script>\n\n\n<br> \n        <div class=\"modal fade\" id=\"myModal\">\n          <div class=\"modal-dialog\">\n            <div class=\"modal-content\">\n              <div class=\"modal-header\">\n                <h4 class=\"modal-title\">Name Change Policy</h4>\n                <button type=\"button pull-right\" class=\"close\" data-dismiss=\"modal\" aria-hidden=\"true\">&times;</button>\n              </div>\n              <div class=\"modal-body\">\n                <p>Requests for name changes in the electronic proceedings will be accepted with no questions asked.  However name changes may cause bibliographic tracking issues.  Authors are asked to consider this carefully and discuss it with their co-authors prior to requesting a name change in the electronic proceedings.</p>\n\n<p>Use the \"Report an Issue\" link to request a name change.</p>\n\n              </div> \n              <div class=\"modal-footer\">\n\n\n              </div>\n            </div><!-- /.modal-content -->\n          </div><!-- /.modal-dialog -->\n        </div><!-- /.modal -->\n\n\n\n<footer class=\"footer\">\n    <div class=\"btn-spacer\">\n        <a href=\"https://neurips.cc/Help/Contact?select=Conference\">Report an Issue</a> &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp;        <a href=\"#\" class=\"modal-link\" data-toggle=\"modal\" data-target=\"#myModal\">Name Change Policy</a>\n    </div>\n\n</footer>\n<div class='hidden'>Do not remove: This comment is monitored to verify that the site is working properly</div>\n<!-- Do not remove: This comment is monitored to verify that the site is working properly -->\n\n</body>\n</html>"
