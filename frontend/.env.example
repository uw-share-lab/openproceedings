# Copy to frontend/.env.local for `npm run dev`. Both values are compiled in by `npm run build`, so set them in
# the build's environment (the `web` image build) for a deployment.

# The API's origin; empty = same origin, behind one reverse proxy (spec 08 §Deploy).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Where rights holders ask for an abstract to be removed, shown in the footer on every page (decision-018):
# an email address or an https:// page. Required for a publicly reachable instance; unset, the footer links to
# the repository's issues page.
NEXT_PUBLIC_TAKEDOWN_CONTACT=takedown@example.org
