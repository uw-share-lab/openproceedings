#!/usr/sbin/nft -f
# Per-source limits on the host, in front of Caddy (TASK-067; owner decision 2026-10-17, TASK-256 option (c);
# deploy/README.md §Per-source limits on the host, spec 08 §Deploy). Load it, as root, with
# deploy/connlimit.sh apply.
#
# Two limits for each source, an IPv4 address or an IPv6 /64, on TCP and UDP 443 (HTTP/3 is on: TASK-257):
#   1. at most 16 connections at once; a new one past it is dropped (a TCP client retries its SYN);
#   2. at most 1 MiB a second of packets to 443, after a burst of 16 MiB; past it, packets are dropped.
# (nft's `define` can't name a rate, so the numbers are written in the rules below; change both rules of a pair.)
# Both are the owner's: the first is TASK-256's option (c), the second was added to it on 2026-10-28. The second
# is its own pair of rules and sets (bytes4, bytes6): delete those and the first stands alone.
# The first bounds uploads over HTTP/1.1, one to a connection, but not over HTTP/2
# or HTTP/3, which carry up to 250 and 100 uploads on one connection (Caddy 2.11.7 sets no stream limit and
# has no setting for one). The second bounds those: the proxy buffers each upload whole (request_buffers,
# decision-035) at about three times what has arrived, and read_body (60s) cuts an upload still arriving, so
# by arithmetic (not yet measured in front of Caddy) one source's buffered bodies cost the proxy at most about
# 3 x (16 MiB + 60 s x 1 MiB/s), some 230 MiB of the 1 GiB limit, however its uploads share connections, plus
# a per-request overhead not yet measured. A 16 MiB file needs 0.27 MiB/s to beat read_body; a search sends a
# few KiB.
#
# The chain hooks prerouting at priority -150: after conntrack (-200), before Docker's DNAT (-100), so it sees
# the host's published port whether Caddy runs in compose or on the host. It limits only packets to one of the
# host's own addresses (Docker's own DNAT test), never a container's HTTPS going out. Traffic from the host
# itself never passes prerouting, so a test run on the host (deploy/smoke-test.sh) is not limited by it.
# When a set is full (262,144 sources), a new source is not limited: nftables fails open there. Spoofed
# packets fill a set too: the byte sets forget a source 20 s after its last packet (about 13,000 spoofed
# packets a second keep one full), and a spoofed SYN's source stays in a connection set while conntrack holds
# its half-open connection (about 4,400 a second at the usual 60 s).

# the host's HTTPS port: OP_HTTPS_PORT's host side if deploy/.env sets it (compose.yml publishes TCP and UDP)
define https_port = 443

# replace only this table: idempotent, and Docker's tables are left alone
table inet openproceedings_limits
delete table inet openproceedings_limits

table inet openproceedings_limits {
	set conns4 {
		type ipv4_addr
		size 262144
		flags dynamic
	}
	set conns6 {
		type ipv6_addr
		size 262144
		flags dynamic
	}
	set bytes4 {
		type ipv4_addr
		size 262144
		flags dynamic,timeout
		timeout 20s
	}
	set bytes6 {
		type ipv6_addr
		size 262144
		flags dynamic,timeout
		timeout 20s
	}

	chain prerouting {
		type filter hook prerouting priority -150; policy accept;
		meta l4proto != { tcp, udp } accept
		th dport != $https_port accept
		fib daddr type != local accept
		ct state new add @conns4 { ip saddr ct count over 16 } counter drop comment "connections"
		ct state new add @conns6 { ip6 saddr and ffff:ffff:ffff:ffff:: ct count over 16 } counter drop comment "connections"
		update @bytes4 { ip saddr limit rate over 1 mbytes/second burst 16 mbytes } counter drop comment "bytes"
		update @bytes6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 1 mbytes/second burst 16 mbytes } counter drop comment "bytes"
	}
}
